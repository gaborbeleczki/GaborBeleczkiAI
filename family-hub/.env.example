# ── Required ──────────────────────────────────────────────────────────────
# Long random string (>= 32 chars). Used to sign sessions and encrypt OAuth tokens.
#   generate: openssl rand -base64 48
APP_SECRET=

# Only these Google accounts can sign in (comma separated).
ALLOWED_EMAILS=you@gmail.com,partner@gmail.com

# The account whose Gmail + Calendar are synced (defaults to the first allowed email).
MAILBOX_OWNER_EMAIL=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application").
# Authorized redirect URI: https://<your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Claude API key (console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
ANTHROPIC_MODEL=

# Postgres connection string (Supabase / Neon / Vercel Postgres). Leave empty in local dev to use an embedded PGlite database.
# Supabase: use the "Transaction pooler" URI (port 6543).
DATABASE_URL=

# Shared secret for /api/cron/* (Vercel Cron sends it automatically as a Bearer token).
CRON_SECRET=

# Public URL of the deployment, used for OAuth redirects (e.g. https://family-hub.vercel.app)
APP_URL=

# ── Optional ──────────────────────────────────────────────────────────────
# Spotify app (developer.spotify.com) for "add podcast to playlist".
# Redirect URI: https://<your-domain>/api/spotify/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Initial family configuration (JSON). Can also be pasted later in Beállítások → Család.
FAMILY_CONFIG_JSON=

# Local development only: enables /api/auth/dev sign-in without Google (ignored in production builds).
DEV_LOGIN=
